rules_version = '2';

// Regras do Firestore (SPEC 8.2). Cada coleção é aberta na etapa em que passa a ser usada.
// As Vercel Functions usam firebase-admin, que ignora estas regras.
// Testes: npm run test:rules (emulador).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function signedIn() {
      return request.auth != null;
    }
    // Login Google com e-mail verificado (instrutores). Duplas usam custom token e não passam aqui.
    function isGoogle() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function allowlistDoc() {
      return /databases/$(database)/documents/allowedInstructors/$(myEmail());
    }
    // Instrutor autorizado e ativo na allowlist.
    function isInstructor() {
      return isGoogle() && exists(allowlistDoc()) && get(allowlistDoc()).data.active == true;
    }
    function isAdmin() {
      return isInstructor() && get(allowlistDoc()).data.role == 'admin';
    }
    function onlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- Duplas (custom token emitido pelas funções da Vercel) ----------
    function isTeam() {
      return signedIn() && request.auth.token.role == 'team';
    }
    function sessionDoc(sid) {
      return get(/databases/$(database)/documents/sessions/$(sid)).data;
    }
    // O token da dupla só vale para a própria sessão, aberta e no prazo (SPEC 5.3).
    function teamSessionOpen() {
      return isTeam()
        && sessionDoc(request.auth.token.sessionId).status == 'open'
        && request.time < sessionDoc(request.auth.token.sessionId).expiresAt;
    }
    function ownsClass(classId) {
      return isInstructor()
        && get(/databases/$(database)/documents/classes/$(classId)).data.instructorId == request.auth.uid;
    }

    // ---------- allowedInstructors/{email} ----------
    // Leitura do próprio e-mail (checagem no login) ou pela admin. Escrita só da admin.
    match /allowedInstructors/{email} {
      allow read: if isGoogle() && (email == myEmail() || isAdmin());
      allow create, update: if isAdmin()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.role in ['admin', 'instructor']
        && request.resource.data.active is bool
        && onlyKeys(['email', 'role', 'addedBy', 'addedAt', 'active'])
        // a admin não pode se desativar nem se rebaixar (evita ficar trancada para fora)
        && (email != myEmail() || (request.resource.data.active == true && request.resource.data.role == 'admin'));
      allow delete: if false;
    }

    // ---------- instructors/{uid} ----------
    match /instructors/{uid} {
      allow read: if isInstructor() && (uid == request.auth.uid || isAdmin());
      allow create, update: if isInstructor()
        && uid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.email == myEmail()
        && request.resource.data.role == get(allowlistDoc()).data.role
        && request.resource.data.displayName is string
        && (resource == null
          ? request.resource.data.createdAt == request.time
          : request.resource.data.createdAt == resource.data.createdAt)
        && onlyKeys(['uid', 'email', 'displayName', 'role', 'createdAt']);
      allow delete: if false;
    }

    // ---------- schools/{schoolId} ----------
    match /schools/{schoolId} {
      allow read: if isInstructor();
      allow update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.active is bool
        && onlyKeys(['name', 'active']);
      allow create, delete: if false;
    }

    // ---------- classes/{classId} ----------
    function validClass(d) {
      return d.keys().hasOnly(['schoolId', 'instructorId', 'name', 'grade', 'level', 'shift', 'season', 'archived', 'createdAt'])
        && d.schoolId is string && exists(/databases/$(database)/documents/schools/$(d.schoolId))
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
        && d.grade in [4, 5, 6, 7, 8, 9]
        && d.level in ['A', 'B', 'C']
        && d.shift in ['manha', 'tarde']
        && d.season is string && d.season.size() <= 10
        && d.archived is bool;
    }

    match /classes/{classId} {
      // RN-01 / 8.2: o instrutor só vê e edita as próprias turmas; a admin lê todas.
      allow read: if (isInstructor() && (resource.data.instructorId == request.auth.uid || isAdmin()))
        || (teamSessionOpen() && request.auth.token.classId == classId);
      allow create: if isInstructor()
        && request.resource.data.instructorId == request.auth.uid
        && request.resource.data.archived == false
        && request.resource.data.createdAt == request.time
        && validClass(request.resource.data);
      allow update: if isInstructor()
        && resource.data.instructorId == request.auth.uid
        && request.resource.data.instructorId == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && validClass(request.resource.data);
      allow delete: if false; // turmas são arquivadas, nunca apagadas
    }

    // ---------- classes/{classId}/teams/{teamId} (dados públicos da dupla) ----------
    // Criação, PIN e pontos passam pelas funções da Vercel. `private/*`: nenhum acesso de cliente.
    function isOwnTeam(classId, teamId) {
      return teamSessionOpen()
        && request.auth.token.classId == classId
        && request.auth.token.teamId == teamId;
    }

    match /classes/{classId}/teams/{teamId} {
      allow read: if ownsClass(classId)
        || isAdmin()
        || (teamSessionOpen() && request.auth.token.classId == classId);
      // Etapa 3: a dupla atualiza só o próprio total, nunca negativo e em passos pequenos
      // (anti-trapaça de nível MVP, SPEC 8.3). Criação e PIN continuam nas funções da Vercel.
      allow update: if isOwnTeam(classId, teamId)
        && changedOnly(['totalPoints'])
        && request.resource.data.totalPoints is int
        && request.resource.data.totalPoints >= 0
        && request.resource.data.totalPoints - resource.data.totalPoints >= -4
        && request.resource.data.totalPoints - resource.data.totalPoints <= 7;
      allow update: if ownsClass(classId)
        && changedOnly(['totalPoints'])
        && request.resource.data.totalPoints is int
        && request.resource.data.totalPoints >= 0;
      allow create, delete: if false;

      // ---------- ledger (histórico de pontos, RN-24) ----------
      match /ledger/{entryId} {
        allow read: if ownsClass(classId) || isAdmin() || isOwnTeam(classId, teamId);
        allow create: if isOwnTeam(classId, teamId)
          && request.resource.data.keys().hasOnly(['sessionId', 'episodeId', 'delta', 'reason', 'at', 'by'])
          && request.resource.data.sessionId == request.auth.token.sessionId
          && request.resource.data.by == 'game'
          && request.resource.data.at == request.time
          && request.resource.data.reason in ['lock_open', 'lock_first', 'event_ok', 'vault_win', 'draw', 'side_bonus', 'wrong_answer', 'hint_1', 'hint_2']
          && request.resource.data.delta is int
          && request.resource.data.delta >= -4
          && request.resource.data.delta <= 5;
        // A Narradora lança pontos do confronto (bônus de lado, vitória no fim, empate) e ajustes manuais.
        allow create: if ownsClass(classId)
          && request.resource.data.keys().hasOnly(['sessionId', 'episodeId', 'delta', 'reason', 'at', 'by'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.delta is int;
        allow update, delete: if false;
      }
    }

    // ---------- sessions/{sessionId} ----------
    match /sessions/{sessionId} {
      // A dupla lê a própria sessão mesmo encerrada (para mostrar "A Narradora ainda não deu o sinal").
      allow read: if (isInstructor() && (resource.data.instructorId == request.auth.uid || isAdmin()))
        || (isTeam() && request.auth.token.sessionId == sessionId);
      // Criada só pela função /api/session-open (código único). A dona controla o andamento.
      allow create, delete: if false;
      allow update: if isInstructor()
        && resource.data.instructorId == request.auth.uid
        && changedOnly(['status', 'phase', 'phaseStartedAt', 'matchesFormed', 'freeze', 'transmission', 'museumEvent', 'autoEventAt'])
        && request.resource.data.status in ['open', 'finished']
        && request.resource.data.phase in ['lobby', 'planning', 'locks', 'vault', 'end'];

      // ---------- sessions/{sessionId}/players/{teamId} ----------
      match /players/{teamId} {
        allow read: if (isInstructor() && (sessionDoc(sessionId).instructorId == request.auth.uid || isAdmin()))
          || (isTeam() && request.auth.token.sessionId == sessionId && request.auth.token.teamId == teamId);
        // A dupla marca presença, escolhe o lado e avança o próprio progresso (o cadeado nunca volta).
        allow update: if teamSessionOpen()
          && request.auth.token.sessionId == sessionId
          && request.auth.token.teamId == teamId
          && changedOnly(['connected', 'lastSeenAt', 'side', 'mode', 'progress', 'hints', 'solvedCount', 'episodePoints', 'finishedAt', 'abilities', 'matchId', 'helpUsed'])
          && request.resource.data.connected is bool
          // matchId: só para entrar sozinha contra a máquina, se ainda não tinha confronto
          && (request.resource.data.get('matchId', null) == resource.data.get('matchId', null)
            || (resource.data.get('matchId', null) == null && request.resource.data.get('matchId', null) == 'maq_' + teamId))
          && (request.resource.data.side == null || request.resource.data.side in ['red', 'blue'])
          && request.resource.data.progress.lockIndex is int
          && request.resource.data.progress.lockIndex >= resource.data.progress.lockIndex
          && request.resource.data.progress.lockIndex <= 3;
        // A Narradora liga cada dupla ao confronto e lança pontos de confronto.
        allow update: if isInstructor()
          && sessionDoc(sessionId).instructorId == request.auth.uid
          && changedOnly(['matchId', 'side', 'episodePoints', 'hints', 'abilities', 'phaseOverride']);
        allow create, delete: if false;
      }

      // ---------- sessions/{sessionId}/matches/{matchId} (cabo de guerra, SPEC 6.1) ----------
      function inMatch(m) {
        return isTeam() && request.auth.token.sessionId == sessionId
          && (m.redTeamId == request.auth.token.teamId || m.blueTeamId == request.auth.token.teamId);
      }
      function validBar() {
        return request.resource.data.bar is number
          && request.resource.data.bar >= -100 && request.resource.data.bar <= 100;
      }
      match /matches/{matchId} {
        allow read: if inMatch(resource.data)
          || (isInstructor() && (sessionDoc(sessionId).instructorId == request.auth.uid || isAdmin()));
        allow create: if (isInstructor() && sessionDoc(sessionId).instructorId == request.auth.uid)
          // dupla atrasada cria o próprio confronto contra a máquina
          || (teamSessionOpen() && request.auth.token.sessionId == sessionId
            && matchId == 'maq_' + request.auth.token.teamId
            && inMatch(request.resource.data)
            && request.resource.data.machineSide in ['red', 'blue']
            && request.resource.data.bar == 0
            && request.resource.data.winner == null);
        // Participantes: puxões, efeitos, log, robô e vitória (o vencedor nunca muda depois de definido).
        allow update: if teamSessionOpen() && inMatch(resource.data)
          && changedOnly(['bar', 'effects', 'log', 'winner', 'resolvedAt', 'machine'])
          && validBar()
          && (resource.data.winner == null || request.resource.data.winner == resource.data.winner);
        allow update: if isInstructor() && sessionDoc(sessionId).instructorId == request.auth.uid
          && changedOnly(['vaultLeader', 'winner', 'resolvedAt', 'bar', 'redTeamId', 'blueTeamId', 'machineSide', 'machine'])
          && validBar();
        allow delete: if isInstructor() && sessionDoc(sessionId).instructorId == request.auth.uid;
      }

      // ---------- chamados de ajuda (RN-30) e linha do tempo do painel ----------
      function sessionOwner() {
        return isInstructor() && (sessionDoc(sessionId).instructorId == request.auth.uid || isAdmin());
      }
      match /helpRequests/{id} {
        allow read: if sessionOwner()
          || (isTeam() && request.auth.token.sessionId == sessionId && resource.data.teamId == request.auth.token.teamId);
        allow create: if teamSessionOpen() && request.auth.token.sessionId == sessionId
          && request.resource.data.keys().hasOnly(['teamId', 'challengeKey', 'createdAt', 'status'])
          && request.resource.data.teamId == request.auth.token.teamId
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time;
        allow update: if sessionOwner() && changedOnly(['status']) && request.resource.data.status in ['open', 'done'];
        allow delete: if false;
      }
      match /feed/{id} {
        allow read: if sessionOwner();
        allow create: if teamSessionOpen() && request.auth.token.sessionId == sessionId
          && request.resource.data.keys().hasOnly(['teamId', 'type', 'payload', 'at'])
          && request.resource.data.teamId == request.auth.token.teamId
          && request.resource.data.type is string && request.resource.data.type.size() <= 20
          && request.resource.data.payload.text is string && request.resource.data.payload.text.size() <= 200
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // ---------- sessions/{sessionId}/firsts/{lockN} (bônus da 1ª dupla a abrir o cadeado N) ----------
      match /firsts/{firstId} {
        allow read: if (isTeam() && request.auth.token.sessionId == sessionId)
          || (isInstructor() && (sessionDoc(sessionId).instructorId == request.auth.uid || isAdmin()));
        // Só pode ser criado uma vez: quem cria primeiro leva o bônus.
        allow create: if teamSessionOpen()
          && request.auth.token.sessionId == sessionId
          && request.resource.data.keys().hasOnly(['teamId', 'at'])
          && request.resource.data.teamId == request.auth.token.teamId
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    // ---------- Todo o resto continua fechado ----------
  }
}
