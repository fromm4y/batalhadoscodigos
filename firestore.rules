rules_version = '2';

// Etapa 0: tudo fechado. Cada coleção é aberta, com suas regras (SPEC 8.2), na etapa em que é usada.
// As Vercel Functions usam firebase-admin, que ignora estas regras.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
