# ---------- Front (Vite) — copiar para .env.local ----------
# Firebase console > Configurações do projeto > Seus apps > App da Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---------- Servidor (Vercel Functions e scripts/seed.ts) ----------
# JSON da conta de serviço codificado em base64 (uma linha só).
# Gerar: base64 -w0 service-account.json   (Mac: base64 -i service-account.json)
FIREBASE_SERVICE_ACCOUNT_JSON=
# E-mail Google da administradora
ADMIN_EMAIL=
