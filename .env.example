# ---------- Front (Vite) — copiar para .env.local ----------
# Firebase console > Configurações do projeto > Seus apps > App da Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---------- Servidor (Vercel Functions e scripts/seed.ts) ----------
# Conteúdo do JSON da conta de serviço. Pode colar o JSON inteiro como baixou
# (na Vercel) ou em base64. No .env.local, use o JSON numa linha só ou base64.
FIREBASE_SERVICE_ACCOUNT_JSON=
# E-mail Google da administradora
ADMIN_EMAIL=
